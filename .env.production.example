APP_NAME="Asaba Hustle"
APP_ENV=production
APP_KEY=YOUR_REAL_APP_KEY
APP_DEBUG=false
APP_URL=https://hustle.oghenekharo.com
CONTACT_VERIFICATION_TOKEN_TTL_MINUTES=10
AUTH_PHONE_ENABLED=true

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=asaba_hustle
DB_USERNAME=asaba
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=YOUR_DIFFERENT_STRONG_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@oghenekharo.com
MAIL_FROM_NAME="${APP_NAME}"

SENDCHAMP_API_KEY=
SENDCHAMP_SENDER_NAME=AsabaHustle
SENDCHAMP_ROUTE=dnd
SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@oghenekharo.com

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Internal server-to-server Reverb configuration
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Browser/client Reverb configuration
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=hustle.oghenekharo.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

ADMIN_USER_NAME=
ADMIN_USER_PHONE=
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=

RUN_MIGRATIONS=true
